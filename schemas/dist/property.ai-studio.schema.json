{
  "title": "Property",
  "description": "One listing as consumed by the property card, detail page, sponsor picker and voice response. Strict: unknown fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_id",
    "street_address",
    "city",
    "state",
    "zip_code",
    "property_type",
    "listing_status",
    "price",
    "bedrooms",
    "bathrooms",
    "square_feet",
    "amenities",
    "local_sponsors"
  ],
  "properties": {
    "property_id": {
      "type": "string",
      "pattern": "^PROP-[0-9]{4,6}$",
      "description": "Primary key of a Property. Example: PROP-0001."
    },
    "street_address": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "description": "Street number and name, without unit."
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "description": "Apartment/suite, only when applicable."
    },
    "city": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "Two-letter uppercase US state or DC code."
    },
    "zip_code": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "description": "5-digit US ZIP. Kept as a string so leading zeros survive (e.g. 02139)."
    },
    "property_type": {
      "type": "string",
      "enum": [
        "single_family",
        "condo",
        "townhouse",
        "multi_family"
      ]
    },
    "listing_status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "sold",
        "coming_soon"
      ]
    },
    "price": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "List price in whole US dollars. No symbols, no commas."
    },
    "bedrooms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "description": "0 means studio."
    },
    "bathrooms": {
      "type": "number",
      "minimum": 0,
      "maximum": 20,
      "multipleOf": 0.5,
      "description": "Half baths count as 0.5."
    },
    "square_feet": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "description": "Interior living area."
    },
    "year_built": {
      "type": "integer",
      "minimum": 1600,
      "maximum": 2100
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "amenities": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "description": "Controlled vocabulary. See docs/adr/001-data-contract.md for why this is an enum and not free text.",
      "items": {
        "type": "string",
        "enum": [
          "pool",
          "garage",
          "fireplace",
          "central_air",
          "hardwood_floors",
          "fenced_yard",
          "solar_panels",
          "ev_charger",
          "washer_dryer",
          "balcony",
          "gym",
          "doorman",
          "pet_friendly",
          "updated_kitchen",
          "walk_in_closet",
          "rooftop_deck"
        ]
      }
    },
    "local_sponsors": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "description": "Denormalized read-model of PropertySponsor rows joined to Sponsor. May be empty.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sponsor_id",
          "name",
          "category",
          "placement_rank"
        ],
        "properties": {
          "sponsor_id": {
            "type": "string",
            "pattern": "^SPN-[0-9]{3,6}$",
            "description": "Primary key of a Sponsor. Example: SPN-004."
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "category": {
            "type": "string",
            "enum": [
              "mortgage",
              "title_escrow",
              "inspection",
              "moving",
              "insurance",
              "landscaping",
              "interior_design",
              "home_warranty"
            ]
          },
          "placement_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "1 = featured first. At most 3 sponsors are shown per property."
          }
        }
      }
    }
  }
}
